{
  "$schema": "mote-design-tokens/1",
  "version": "rev5",
  "units": "Lengths are dp; colours are #RRGGBB or #AARRGGBB (alpha first, Compose Color(0xAARRGGBB)). Gradients run top->bottom unless an angle is given. Layers are painted in array order (index 0 = bottom).",
  "source": "design/mote-v1/mote.css. The mockup is the target; the Compose app must render these 1:1.",

  "textures": {
    "grain": {
      "comment": "Shared speck noise. Generate once at startup, ~4 KB in memory.",
      "bitmapPx": 128, "cellDp": 1.0, "tile": "Repeated both axes",
      "generate": "value noise: 2 octaves (freq 0.9/cell, 1.8/cell, amp 1, 0.5), seed 7, normalised to [0,1]; then contrast-stretch v' = clamp(2.4*v - 0.7, 0, 1); grey (r=g=b=v'), opaque",
      "drawScale": "draw the 128px bitmap so 1 px = 1 dp (ImageShader + Matrix.setScale(density, density))"
    },
    "brushed": {
      "comment": "Anisotropic brushed-metal streaks, horizontal. Generated at runtime: noise stretched along X.",
      "bitmapPx": [512, 128], "tile": "Repeated both axes",
      "generate": "value noise with frequency X 0.004/px, Y 0.9/px, 2 octaves, seed 3; grey; opaque. Equivalent: per row y pick r(y) in [0,1], then v(x,y) = 0.75*r(y) + 0.25*noise1D(x/250 + y*17)",
      "drawScale": "1 px = 1 dp"
    }
  },

  "themes": {
    "light": {
      "color": {
        "chassisTop": "#EEEFF1", "chassisBot": "#D9DBDF", "bg": "#E3E5E8",
        "surface1": "#E9EAED", "surface2": "#DFE1E4", "surface3": "#D2D5D9", "surface4": "#C6C9CE",
        "well": "#CBCED3", "outline": "#C3C6CB",
        "keyTop": "#FBFBFC", "keyBot": "#E6E7EA", "keyEdge": "#B4B8BE",
        "rubTop": "#D3D5D9", "rubBot": "#C3C6CB", "rubWall": "#9EA2A9",
        "primTop": "#43464D", "primBot": "#26282C", "primEdge": "#121316", "onPrim": "#F3F4F6",
        "glassTop": "#EBFFFFFF", "glassBot": "#DBE2E8F0", "glassInk": "#1C1D20", "glassGlow": "#3840A0FF",
        "onSurface": "#1C1D20", "onSurfaceMuted": "#50535A", "onSurfaceSubtle": "#62656C",
        "accent": "#1D6FB8", "accentGlow": "#7340A0FF", "onAccent": "#FFFFFF", "accentContainer": "#D3E3F3",
        "modifierArmed": "#FFD60A", "modifierTop": "#FFE14D", "modifierBot": "#F0C400", "onModifier": "#1A1A1D",
        "danger": "#B3261E", "dangerContainer": "#F6D9D6",
        "linkConnected": "#1F9A55", "linkConnecting": "#A87F00", "linkDisconnected": "#C4302A",
        "scrim": "#661E2228",
        "hi": "#F2FFFFFF", "lo": "#2928303C", "shadow": "#421E2632",
        "engraveFill": "#C4C7CC", "engraveDark": "#6B141C28", "engraveLight": "#FFFFFFFF",
        "bezelTop": "#B9BDC3", "bezelBot": "#D6D9DD",
        "metalStops": [["0.00", "#FDFDFE"], ["0.48", "#D4D7DC"], ["0.52", "#BFC3C9"], ["1.00", "#E6E8EB"]],
        "metalEdge": "#8D9198",
        "ringMetalSweep": ["#F2F3F5", "#B8BCC2", "#F7F8F9", "#AEB2B9", "#EEF0F2", "#B3B7BE", "#F5F6F7", "#ADB1B8", "#F2F3F5"]
      },
      "grainAlpha": { "plate": 0.11, "plastic": 0.08, "rubber": 0.12, "metal": 0.06, "glass": 0.04 },
      "brushedAlpha": { "plate": 0.32, "metal": 0.42 },
      "sheen": {
        "plate": { "angleDeg": 90, "stops": [["0.00", "#00FFFFFF"], ["0.30", "#61FFFFFF"], ["0.52", "#00FFFFFF"], ["0.74", "#2EFFFFFF"], ["0.90", "#00FFFFFF"]] },
        "metal": { "angleDeg": 90, "stops": [["0.00", "#00FFFFFF"], ["0.35", "#8CFFFFFF"], ["0.60", "#00FFFFFF"]] }
      },
      "vignette": { "center": [0.5, 0.38], "radiusX": 1.30, "radiusY": 0.90, "stops": [["0.55", "#001E2632"], ["1.00", "#241E2632"]] },
      "gloss": [["0.00", "#F2FFFFFF"], ["0.38", "#59FFFFFF"], ["0.40", "#00FFFFFF"]]
    },
    "dark": {
      "color": {
        "chassisTop": "#26282D", "chassisBot": "#17181B", "bg": "#1C1D21",
        "surface1": "#27292E", "surface2": "#2E3036", "surface3": "#383B42", "surface4": "#43464E",
        "well": "#0B0C0E", "outline": "#3A3D44",
        "keyTop": "#474A52", "keyBot": "#363940", "keyEdge": "#101114",
        "rubTop": "#2B2D32", "rubBot": "#232529", "rubWall": "#0E0F11",
        "primTop": "#4B5059", "primBot": "#24272C", "primEdge": "#0C0D10", "onPrim": "#8FD3FF",
        "glassTop": "#C7464E5C", "glassBot": "#EB161A20", "glassInk": "#9ED9FF", "glassGlow": "#596CC4FF",
        "onSurface": "#E9EAEC", "onSurfaceMuted": "#A9ACB2", "onSurfaceSubtle": "#8F939A",
        "accent": "#6CC4FF", "accentGlow": "#8C6CC4FF", "onAccent": "#06121C", "accentContainer": "#1B2E3D",
        "modifierArmed": "#FFD60A", "modifierTop": "#FFE14D", "modifierBot": "#F2C200", "onModifier": "#1A1400",
        "danger": "#FF6B66", "dangerContainer": "#3E1A1C",
        "linkConnected": "#3DDC84", "linkConnecting": "#FFB020", "linkDisconnected": "#FF6B66",
        "scrim": "#9E040508",
        "hi": "#1AFFFFFF", "lo": "#59000000", "shadow": "#8C000000",
        "engraveFill": "#1C1D21", "engraveLabelFill": "#4F535B", "engraveDark": "#D9000000", "engraveLight": "#17FFFFFF",
        "bezelTop": "#08090A", "bezelBot": "#16171A",
        "metalStops": [["0.00", "#C9CDD3"], ["0.48", "#8C9198"], ["0.52", "#6F747C"], ["1.00", "#A3A8AF"]],
        "metalEdge": "#2A2C30",
        "ringMetalSweep": ["#8E939A", "#4B4F56", "#9A9FA6", "#464A51", "#8B9097", "#484C53", "#969BA2", "#43474E", "#8E939A"]
      },
      "grainAlpha": { "plate": 0.15, "plastic": 0.11, "rubber": 0.15, "metal": 0.08, "glass": 0.06 },
      "brushedAlpha": { "plate": 0.42, "metal": 0.42 },
      "sheen": {
        "plate": { "angleDeg": 90, "stops": [["0.00", "#00FFFFFF"], ["0.30", "#12FFFFFF"], ["0.52", "#00FFFFFF"], ["0.74", "#0AFFFFFF"], ["0.90", "#00FFFFFF"]] },
        "metal": { "angleDeg": 90, "stops": [["0.00", "#00FFFFFF"], ["0.35", "#59FFFFFF"], ["0.60", "#00FFFFFF"]] }
      },
      "vignette": { "center": [0.5, 0.38], "radiusX": 1.30, "radiusY": 0.90, "stops": [["0.50", "#00000000"], ["1.00", "#73000000"]] },
      "gloss": [["0.00", "#47FFFFFF"], ["0.38", "#14FFFFFF"], ["0.40", "#00FFFFFF"]]
    }
  },

  "radius": {
    "xs": 6, "s": 12, "m": 20, "l": 28, "full": 9999,
    "key": 7, "keyUpper": 10, "modifier": 10, "tile": 20, "fav": 16, "pill": 9999,
    "pairWell": 24, "pairCap": 19, "pairSmallWell": 20, "pairSmallCap": 15,
    "railTrack": 20, "railSeg": 16, "slider": 28, "sliderThumb": 12,
    "channel": 30, "glassSmall": 20, "glassPlay": 24, "sheetTop": 28, "field": 14, "button": 18,
    "rule": "nested radius = outer - padding, min 6"
  },

  "shadow": {
    "comment": "Drop shadows: draw a blurred copy of the shape (Paint + BlurMaskFilter via drawIntoCanvas, or Modifier.shadow with spot/ambient colour = shadow). 'edge' is a crisp 0-blur copy offset down, painted first.",
    "plastic": [ { "y": 1, "blur": 0, "color": "keyEdge" }, { "y": 2, "blur": 3, "color": "shadow", "alphaMul": 0.38 }, { "y": 8, "blur": 14, "spread": -6, "color": "shadow", "alphaMul": 0.66 } ],
    "keycap": [ { "y": 1, "blur": 0, "color": "keyEdge" }, { "y": 2, "blur": 3, "color": "shadow", "alphaMul": 0.62 } ],
    "rubberDisc": [ { "y": 3, "blur": 0, "color": "rubWall", "comment": "side wall" }, { "y": 6, "blur": 8, "color": "shadow", "comment": "contact shadow" } ],
    "metalThumb": [ { "y": 0, "blur": 0, "spread": 1, "color": "metalEdge" }, { "y": 3, "blur": 4, "color": "shadow" }, { "y": 8, "blur": 12, "spread": -6, "color": "shadow" } ],
    "glass": [ { "y": 1, "blur": 0, "color": "keyEdge" }, { "y": 4, "blur": 6, "color": "shadow" }, { "y": 12, "blur": 20, "spread": -10, "color": "shadow" } ],
    "dpadBezel": [ { "y": 6, "blur": 10, "spread": -4, "color": "shadow" } ],
    "innerWell": { "comment": "Inner shadow: clipPath(shape) then draw the shape outline as a stroke of width 2*blur offset by y, with BlurMaskFilter(blur). Then a 1dp bottom highlight line.", "light": { "y": 2, "blur": 5, "color": "#42141C28", "bottomHighlight": "#D9FFFFFF" }, "dark": { "y": 2, "blur": 6, "color": "#B3000000", "bottomHighlight": "#0FFFFFFF" } },
    "bevelTop": { "comment": "plastic, metal, glass: 1dp inner line at top", "color": "hi" },
    "bevelBottom": { "comment": "1dp inner line at bottom", "color": "lo" }
  },

  "materials": {
    "backplate": { "layers": [
      { "type": "verticalGradient", "colors": ["chassisTop", "chassisBot"] },
      { "type": "texture", "texture": "brushed", "alpha": "brushedAlpha.plate", "blend": "Overlay" },
      { "type": "linearGradient", "ref": "sheen.plate" },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.plate", "blend": "Overlay" },
      { "type": "radialGradient", "ref": "vignette", "note": "elliptical: scale(radiusX/radiusY, 1) about the centre in DrawScope, then a circular radialGradient" }
    ] },
    "plastic": { "usedBy": ["favourite", "brightness caps", "mute", "rail selected segment", "pill", "keys", "modifiers (idle)", "tiles", "Edit button", "sheet"],
      "layers": [
        { "type": "shadow", "ref": "shadow.plastic" },
        { "type": "verticalGradient", "colors": ["keyTop", "keyBot"] },
        { "type": "texture", "texture": "grain", "alpha": "grainAlpha.plastic", "blend": "Overlay" },
        { "type": "innerLine", "edge": "top", "width": 1, "color": "hi" },
        { "type": "innerLine", "edge": "bottom", "width": 1, "color": "lo" }
      ], "pressed": "swap gradient (keyBot->keyTop), replace drop shadows with innerWell {y:2, blur:4, #73000000}, translationY 1dp" },
    "rubber": { "usedBy": ["D-pad disc", "OK cap"], "layers": [
      { "type": "shadow", "ref": "shadow.rubberDisc" },
      { "type": "verticalGradient", "colors": ["rubTop", "rubBot"] },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.rubber", "blend": "Overlay" },
      { "type": "strokeGradient", "width": 1.5, "inset": 0.75, "stops": [["0.00", "#E6FFFFFF"], ["0.35", "#00FFFFFF"], ["0.70", "#00000000"], ["1.00", "#38000000"]], "comment": "full-circle bevel" }
    ], "noGloss": true },
    "metal": { "usedBy": ["slider thumbs", "settings slider thumb"], "layers": [
      { "type": "shadow", "ref": "shadow.metalThumb" },
      { "type": "verticalGradient", "stops": "metalStops", "comment": "hard step at 0.48/0.52 = turned edge" },
      { "type": "texture", "texture": "brushed", "alpha": "brushedAlpha.metal", "blend": "Overlay" },
      { "type": "linearGradient", "ref": "sheen.metal" },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.metal", "blend": "Overlay" },
      { "type": "innerLine", "edge": "top", "width": 1, "color": "#E6FFFFFF" },
      { "type": "innerLine", "edge": "bottom", "width": 1, "color": "#40000000" }
    ] },
    "metalRing": { "usedBy": ["D-pad bezel ring (outer 104, inner gap well r99)"], "layers": [
      { "type": "shadow", "ref": "shadow.dpadBezel" },
      { "type": "sweepGradient", "colors": "ringMetalSweep", "comment": "radial brushed sheen; 8 equal stops from 12 o'clock" },
      { "type": "texture", "texture": "brushed", "alpha": "brushedAlpha.metal", "blend": "Overlay" },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.metal", "blend": "Overlay" },
      { "type": "innerLine", "edge": "top", "width": 1, "color": "hi" }
    ] },
    "glass": { "usedBy": ["prev", "play/pause", "next"], "layers": [
      { "type": "shadow", "ref": "shadow.glass" },
      { "type": "verticalGradient", "colors": ["glassTop", "glassBot"] },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.glass", "blend": "Overlay" },
      { "type": "innerShadow", "y": -10, "blur": 18, "spread": -8, "color": "glassGlow", "comment": "inner LED glow from the bottom" },
      { "type": "verticalGradient", "ref": "gloss", "comment": "specular band, hard edge at 40%" },
      { "type": "innerLine", "edge": "top", "width": 1, "color": "#E6FFFFFF", "dark": "#59FFFFFF" },
      { "type": "innerBorder", "width": 1, "color": "#40FFFFFF", "dark": "#0FFFFFFF" }
    ], "legend": { "light": "glassInk", "dark": "glassInk + glow: draw icon blurred 6dp at glassGlow behind it (Modifier.blur, API 31+; no glow below 31)" } },
    "primary": { "usedBy": ["Save macro", "Pair new device"], "layers": [
      { "type": "shadow", "list": [ { "y": 1, "blur": 0, "color": "primEdge" }, { "y": 3, "blur": 5, "color": "#4D000000" }, { "y": 10, "blur": 18, "spread": -8, "color": "#73000000" } ] },
      { "type": "verticalGradient", "colors": ["primTop", "primBot"] },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.plastic", "blend": "Overlay" },
      { "type": "verticalGradient", "stops": [["0.00", "#29FFFFFF"], ["0.45", "#00FFFFFF"]] },
      { "type": "innerLine", "edge": "top", "width": 1, "color": "#38FFFFFF" }
    ] },
    "well": { "usedBy": ["slider slots", "transport channel", "pair housings", "rail track", "fields", "touchpad"], "layers": [
      { "type": "fill", "color": "well", "channelOverride": "verticalGradient bezelTop->bezelBot for transport channel" },
      { "type": "texture", "texture": "grain", "alpha": "grainAlpha.rubber", "blend": "Overlay" },
      { "type": "innerShadow", "ref": "shadow.innerWell" }
    ] },
    "engraving": { "usedBy": ["MOTE wordmark (Unbounded Black 19sp, tracking 2.5sp)", "SCROLL/VOLUME labels (Unbounded Black 9sp, tracking 2sp)"],
      "draw": "text 3x: engraveDark at y-1dp (plus a 2dp-blur copy at 30% for the wordmark), engraveLight at y+1dp, then engraveFill (dark labels use engraveLabelFill)" }
  },

  "components": {
    "dpad": { "size": 208, "bezelRing": [99, 104], "disc": 96, "okRing": 42, "okCap": 35, "material": "rubber", "ring": "metalRing" },
    "slider": { "slot": [56, 232], "thumb": [36, 60], "ticksEveryDp": 14, "tickLen": 6, "tickWidth": 1.5, "tickColor": "onSurfaceSubtle@55%", "centreLine": 2, "endTap": 32, "label": "engraving 9sp" },
    "transportChannel": { "padding": 8, "gap": 8, "columns": [72, "fill", 72], "smallHeight": 72, "playHeight": 96 },
    "mute": { "size": 48, "material": "plastic", "position": "D-pad lower right, beside the volume slider's − end" },
    "favourite": { "height": 64, "radius": 16, "addSlot": "dashed 1.5dp keyEdge, dash 6/4" },
    "rail": { "height": 80, "track": 60, "trackPadding": 4, "selected": "plastic", "selectedIcon": "accent + glow 4dp" }
  },

  "parity": {
    "swaps": [
      "Offline dimming: opacity 0.35 only (removed the CSS saturate filter).",
      "Bezel/channel: explicit bezelTop/bezelBot stops (removed CSS color-mix).",
      "SVG feTurbulence in the mockup = the 'grain'/'brushed' runtime bitmaps above; same frequencies and alphas.",
      "CSS multi-value text-shadow = draw text 3x (Compose TextStyle supports one shadow).",
      "CSS inset box-shadow = clipped blurred stroke (see shadow.innerWell).",
      "CSS drop-shadow filter on icons (LED glow) = blurred icon copy, API 31+ only; acceptable to omit below 31."
    ]
  }
}
