{
  "manifest_version": 3,
  "name": "Mote Video Bridge (preview)",
  "short_name": "Mote Video",
  "version": "0.1.0",
  "description": "Control the video in this browser from the Mote app, through Mote Helper on this Mac. Labs preview.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mote Video Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["adapters.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
