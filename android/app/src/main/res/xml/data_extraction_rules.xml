<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: paired-host tokens are bound to this device's Keystore, so a copy
     would be useless on another phone (and the Bluetooth bonds don't transfer either). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
